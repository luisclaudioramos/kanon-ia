{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/identity-seals-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/seal-registry-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/seals-write-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/core-agnostic-gate.js\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/seal-routing-gate.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/core-agnostic-commit-gate.js\"",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/branch-delete-guard.js\"",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/develop-merge-squash-gate.js\"",
            "if": "Bash(git merge*)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/pr-publish-consent-gate.js\"",
            "if": "Bash(gh *)"
          }
        ]
      }
    ]
  }
}