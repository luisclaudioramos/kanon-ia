# Estado local do Claude Code — não descreve o harness e não viaja entre máquinas.
# settings.local.json acumula permissões de sessões passadas, com caminhos absolutos
# desta máquina; RESUME.md é checkpoint de sessão interrompida; kanon.local.json guarda o
# contexto ativo (para qual equipe o kanon trabalha nesta máquina).
.claude/settings.local.json
.claude/RESUME.md
.claude/kanon.local.json

# Configuração local do Obsidian, que usa esta pasta como cofre — muda a cada uso e não descreve o harness.
.obsidian/

# Saída de ferramentas de sessão — snapshots e logs do Playwright MCP e rascunhos de
# execução de planos do superpowers; não descrevem o harness.
.playwright-mcp/
.superpowers/
